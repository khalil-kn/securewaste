' Shared look for every SecureWaste diagram. Include with: !include _style.iuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor #3B4A5E
skinparam ArrowFontSize 12
skinparam ArrowFontColor #1F2A37
skinparam ArrowFontStyle plain
skinparam linetype ortho
skinparam ActorBorderColor #1F2A37
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #2563EB
skinparam UsecaseBackgroundColor #EFF4FF
skinparam RectangleBorderColor #3B4A5E
skinparam ClassBorderColor #3B4A5E
skinparam ClassBackgroundColor #F8FAFC
skinparam ClassHeaderBackgroundColor #E2E8F0
skinparam StateBorderColor #3B4A5E
skinparam StateBackgroundColor #F1F5F9
skinparam ComponentBorderColor #3B4A5E
skinparam ComponentBackgroundColor #F8FAFC
skinparam DatabaseBorderColor #3B4A5E
skinparam DatabaseBackgroundColor #FEF3C7
skinparam NodeBorderColor #3B4A5E
skinparam NodeBackgroundColor #F8FAFC
skinparam FolderBackgroundColor #FEF9C3
skinparam ActivityBorderColor #3B4A5E
skinparam ActivityBackgroundColor #F1F5F9
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam SwimlaneTitleFontStyle bold
skinparam SequenceLifeLineBorderColor #94A3B8
skinparam SequenceParticipantBorderColor #3B4A5E
skinparam SequenceParticipantBackgroundColor #F8FAFC
skinparam SequenceGroupBorderColor #64748B
skinparam SequenceGroupHeaderFontStyle bold
skinparam SequenceBoxBorderColor #CBD5E1
skinparam NoteBackgroundColor #FFFBEB
skinparam NoteBorderColor #D97706
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
hide circle
