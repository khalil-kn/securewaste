# Copy this file to .env and fill in real values. Never commit .env.
# Generate keys with:  python -c "import secrets; print(secrets.token_hex(32))"
SECUREWASTE_SECRET_KEY=change-me
SECUREWASTE_HMAC_KEY=change-me-too

FLASK_DEBUG=0
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=100
MAX_EXTRACTED_CHARS=2000000
MIN_CONFIDENCE=0.30
STORAGE_DIR=instance/storage
DATABASE_PATH=instance/securewaste.db
SECUREWASTE_KEYWORDS=salary,password,confidential agreement
