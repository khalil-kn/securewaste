# PostgreSQL connection of the cloud API.
CLOUD_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securewaste_cloud

# Where the API listens. Keep it on the loopback interface while it runs locally.
CLOUD_API_HOST=127.0.0.1
CLOUD_API_PORT=5001

# Per-employee credentials, comma separated, one entry per employee token:
#   sha256_of_token:role:employee_uuid:expires_at_epoch_seconds
# Roles: employee, admin, security_officer. Only employee and admin may store scan events.
# Generate entries with: python scripts/issue_credential.py <employee_uuid> <role> --ttl-days 30
# The script prints the plaintext token once (give it to the employee) and the entry to paste here.
# Never put plaintext tokens in this file. While this is empty, every protected request gets 401.
CLOUD_API_CREDENTIALS=
CLOUD_API_MAX_TOKEN_TTL_SECONDS=7776000