# PostgreSQL connection of the cloud API.
CLOUD_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/securewaste_cloud

# Where the API listens. Keep it on the loopback interface while it runs locally.
CLOUD_API_HOST=127.0.0.1
CLOUD_API_PORT=5001

# Bearer tokens and their roles, separated by commas: token:role.
# A role that may store scan events: employee, admin, security_officer.
# Replace these placeholders before running the service.
CLOUD_API_TOKENS=employee-token:employee,admin-token:admin,security-token:security_officer
